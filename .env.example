# Variáveis de ambiente do app (copie para .env e preencha). Nenhuma é obrigatória para rodar:
# sem elas, a função correspondente simplesmente não age.

# --- Supabase (o Lovable Cloud preenche estas) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Só no servidor: usada pelos lembretes e pelo crédito de pagamentos.
SUPABASE_SERVICE_ROLE_KEY=

# --- Endereço público do app (links em e-mails, sitemap e imagem de compartilhamento) ---
PUBLIC_SITE_URL=
VITE_PUBLIC_SITE_URL=

# --- Analytics de funil (PostHog), só com consentimento ---
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com

# --- E-mail (Resend): resultado da calculadora e lembretes ---
RESEND_API_KEY=
RESEND_FROM=Previdência Intelligence <ola@seudominio.com.br>

# --- Lembretes: segredo que o agendador manda em Authorization: Bearer ---
CRON_SECRET=

# --- Cobrança (Mercado Pago). Desligada até VITE_BILLING_ENABLED=true ---
VITE_BILLING_ENABLED=false
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=
